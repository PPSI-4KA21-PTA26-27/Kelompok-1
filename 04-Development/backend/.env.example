# Salin ke .env lalu isi. JANGAN commit .env. Semua nilai di bawah hanya placeholder.

# --- Wajib di semua environment ---
APP_ENV=development                # development | test | production
PORT=8080
DATABASE_URL=                      # postgres://user:password@host:5432/dbname?sslmode=disable
JWT_ACCESS_SECRET=                 # acak, minimal 32 karakter. Buat: openssl rand -hex 32
JWT_ISSUER=hii-stranger-api

# --- Wajib di production ---
FRONTEND_URL=                      # contoh: https://hii-stranger.example.com (https wajib di production)
CORS_ALLOWED_ORIGINS=              # daftar origin dipisah koma; tanpa wildcard. Kosong = pakai FRONTEND_URL

# --- Opsional (ada default) ---
ACCESS_TOKEN_TTL=15m               # 1m..1h
REFRESH_TOKEN_TTL=720h             # lebih besar dari access TTL, maks 2160h
LOG_LEVEL=info                     # debug | info | warn | error
MAX_BODY_BYTES=1048576
TRUSTED_PROXIES=                   # IP/CIDR reverse proxy tepercaya, dipisah koma. Kosong = tidak percaya proxy mana pun
DB_MAX_CONNS=10
DB_MIN_CONNS=2
DB_STATEMENT_TIMEOUT=15s
HTTP_REQUEST_TIMEOUT=25s

# --- Hanya untuk docker compose lokal ---
POSTGRES_PASSWORD=                 # gunakan hex agar aman di dalam URL: openssl rand -hex 16

# --- Fase berikutnya (belum dipakai kode saat ini) ---
# MIDTRANS_SERVER_KEY=
# MIDTRANS_CLIENT_KEY=
# MIDTRANS_IS_PRODUCTION=false
# EMAIL_PROVIDER=
# EMAIL_API_KEY=
