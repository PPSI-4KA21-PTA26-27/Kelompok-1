# Salin file ini menjadi .env lalu isi nilainya. Jangan commit .env.

APP_ENV=dev
APP_VERSION=1.2.9
# Versi lama yang masih dilayani di /api/v<versi>, dipisah koma (opsional).
API_LEGACY_VERSIONS=
PORT=8080
LOG_LEVEL=info

# Database PostgreSQL
DB_URL=postgres://user:password@localhost:5432/--?sslmode=disable
DB_MAX_CONNS=10
DB_MIN_CONNS=2
DB_STATEMENT_TIMEOUT=5s

# JWT (secret minimal 32 karakter)
JWT_SECRET=ganti-dengan-string-acak-minimal-32-karakter
JWT_ISSUER=hii-stranger
# Tanpa refresh token, TTL pendek membuat pelanggan ter-logout di tengah checkout.
ACCESS_TOKEN_TTL=12h

MAX_BODY_BYTES=1048576
HTTP_REQUEST_TIMEOUT=25s
FRONTEND_URL=http://localhost:3000
# Baca IP klien dari header proxy (CF-Connecting-IP, X-Real-IP, X-Forwarded-For)
# untuk rate limit. Set true di Railway; biarkan false bila tanpa proxy.
TRUST_PROXY_HEADERS=false
# Batas request API yang diproses bersamaan; penuh = 503 server_busy. 0 = nonaktif.
MAX_CONCURRENT_REQUESTS=200

# Email notifikasi lewat Gmail. SMTP_PASS memakai App Password Google
# (Akun Google > Keamanan > Verifikasi 2 langkah > Sandi aplikasi).
# Kosongkan SMTP_HOST untuk mematikan email.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tokokamu@gmail.com
SMTP_PASS=app-password-16-karakter
SMTP_FROM=Hii Stranger <tokokamu@gmail.com>
# Penerima notifikasi order & bukti pembayaran baru
OWNER_EMAIL=pemilik@gmail.com

# Cloudinary untuk unggah gambar produk & banner (Dashboard > API Keys)
CLOUDINARY_CLOUD_NAME=nama-cloud
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=rahasia-cloudinary
CLOUDINARY_FOLDER=hii-stranger

# RajaOngkir (https://collaborator.komerce.id) untuk wilayah & ongkir sampai kelurahan.
# RAJAONGKIR_ORIGIN_ID = ID kelurahan toko; cari lewat
# GET /api/v1/regions/provinces -> .../cities -> .../districts -> .../subdistricts
# RAJAONGKIR_COURIERS = kurir toko (pos = POS Indonesia); pelanggan tidak memilih kurir.
RAJAONGKIR_API_KEY=api-key-rajaongkir
RAJAONGKIR_BASE_URL=https://rajaongkir.komerce.id/api/v1
RAJAONGKIR_ORIGIN_ID=
RAJAONGKIR_COURIERS=pos

# redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
